# Stoop web — environment template
# Copy to apps/web/.env and fill in real values before running `bun run dev`.
# NEVER commit .env (gitignored via the root .gitignore's `.env` rule / the
# `*.local` rule here). Do not hand-copy values from apps/api/.env — this
# app only ever needs the two PUBLIC values below (the anon key is
# publishable by design; row-level security enforces access). The
# service-role key must never appear anywhere in this app.
#
# Vite only inlines vars prefixed VITE_ into the client bundle
# (import.meta.env.VITE_*) — see src/lib/env.ts. Unset any of these and the
# app degrades gracefully instead of crashing: src/lib/supabase.ts's client
# is null and sign-in shows a "not set up" state; src/api/client.ts throws
# an honest not_configured error instead of guessing a URL.
#
# Values: Supabase dashboard -> Project Settings -> API.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# apps/api's base URL (docs/03-engineering/api-contracts.md). No default —
# unlike apps/mobile's localhost fallback, a web build genuinely has
# nothing sane to point at until this is set.
VITE_API_URL=http://localhost:8000
